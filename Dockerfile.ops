# Small operations overlay, not a new web/worker release.
ARG SAU_RUNTIME_IMAGE
FROM ${SAU_RUNTIME_IMAGE}
ARG SAU_RUNTIME_ID
ARG SAU_OPS_REVISION
LABEL io.sau.operations-tools="1" \
      io.sau.operations-revision="${SAU_OPS_REVISION}" \
      io.sau.runtime-image="${SAU_RUNTIME_ID}"
USER 0
COPY sau_inbox/watch.py sau_inbox/thumb.py sau_inbox/manual_platforms.py sau_inbox/gen_title.py sau_inbox/inbox_monitor.py /app/sau_inbox/
COPY scripts/push_credentials_vault.py scripts/push_llm_stt_vault.py /app/scripts/
COPY myUtils/inbox_archive.py /app/myUtils/inbox_archive.py
COPY docker/ops-entrypoint.py /usr/local/bin/sau-ops-runner.py
RUN chmod 0444 /app/sau_inbox/*.py /app/scripts/push_credentials_vault.py /app/scripts/push_llm_stt_vault.py /app/myUtils/inbox_archive.py /usr/local/bin/sau-ops-runner.py \
    && mkdir -p /home/will/social-auto-upload/ops \
    && test ! -e /home/will/sau-inbox && test ! -L /home/will/sau-inbox \
    && ln -s /app/sau-inbox /home/will/sau-inbox \
    && test ! -e /home/will/social-auto-upload/ops/inbox && test ! -L /home/will/social-auto-upload/ops/inbox \
    && ln -s /app/sau-inbox /home/will/social-auto-upload/ops/inbox
# Keep the existing numeric identity while giving OpenSSH/rclone valid NSS data.
RUN if ! getent group 1000 >/dev/null; then groupadd --gid 1000 sau; fi \
    && if ! getent passwd 1000 >/dev/null; then useradd --uid 1000 --gid 1000 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin sau; fi \
    && test "$(getent passwd 1000 | cut -d: -f4)" = 1000
USER 1000:1000
WORKDIR /app
ENTRYPOINT ["python", "/usr/local/bin/sau-ops-runner.py"]
