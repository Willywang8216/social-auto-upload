# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly mark binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.avi binary
*.webm binary
*.mp3 binary
*.wav binary
*.zip binary
*.tar.gz binary
*.7z binary

# Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Ensure shell scripts use LF
*.sh text eol=lf
*.bash text eol=lf

# Ensure Python uses LF
*.py text eol=lf

# Ensure JavaScript/TypeScript uses LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf

# Ensure config files use LF
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf

# Ensure documentation uses LF
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Docker files
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Environment files
.env text eol=lf
.env.* text eol=lf

# SQL files
*.sql text eol=lf

# Vue/React components
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.html text eol=lf
